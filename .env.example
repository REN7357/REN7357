DATABASE_URL="file:./dev.db"
AUTH_SECRET="your-secret-here"
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
# Shopify Admin API
SHOPIFY_SHOP="tedhair.myshopify.com"
# Dev Dashboard 应用填 CLIENT_ID + API_SECRET；旧版自定义应用另填 ADMIN_TOKEN
SHOPIFY_CLIENT_ID="client-id"
SHOPIFY_API_SECRET="client-secret"
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_API_VERSION="2026-07"
# ERP 仓库编码 → Shopify 门店 Location ID
SHOPIFY_LOCATION_MAP='{"NY01":"gid://shopify/Location/111","NY02":"gid://shopify/Location/222"}'
# 自研 ERP
ERP_BASE_URL="https://erp.example.com/api/shopify"
ERP_API_KEY="erp-outbound-key"
ERP_INBOUND_TOKEN="token-erp-uses-to-call-us"
